<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<AnchorPane id="AnchorPane" prefHeight="380.0" prefWidth="550.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.programadoreschidos.abarroteria.kinal.controller.DashboardController">
    <stylesheets>
        <URL value="@/main/resources/css/dashboard-style.css" />
    </stylesheets>
   <children>
      <GridPane hgap="10" layoutX="20.0" layoutY="20.0" prefHeight="340.0" prefWidth="510.0" vgap="12">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints maxHeight="275.0" minHeight="10.0" prefHeight="275.0" vgrow="SOMETIMES" />
          <RowConstraints maxHeight="55.0" minHeight="10.0" prefHeight="45.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <TableView fx:id="tableProducto" prefHeight="275.0" prefWidth="510.0">
              <columns>
                <TableColumn fx:id="tableColumnIdProducto" prefWidth="90.0" text="ID" />
                <TableColumn fx:id="tableColumnNombreProducto" prefWidth="190.0" text="Nombre" />
                <TableColumn fx:id="tableColumnStock" prefWidth="90.0" text="Stock" />
                <TableColumn fx:id="tableColumnPrecio" prefWidth="120.0" text="Precio" />
              </columns>
            </TableView>
            <Button mnemonicParsing="false" onAction="#handleEliminarProducto" prefHeight="35.0" prefWidth="261.0" text="Eliminar Producto" GridPane.halignment="RIGHT" GridPane.rowIndex="1" />
         </children>
      </GridPane>
   </children>
</AnchorPane>
