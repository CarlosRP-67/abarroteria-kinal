<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<AnchorPane id="AnchorPane" prefHeight="420.0" prefWidth="550.0" styleClass="mainFxmlClass" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.programadoreschidos.abarroteria.kinal.controller.DashboardController">
    <stylesheets>
        <URL value="@/main/resources/css/dashboard-style.css" />
    </stylesheets>
   <children>
      <GridPane hgap="10" layoutX="20.0" layoutY="20.0" prefHeight="380.0" prefWidth="510.0" vgap="12">
        <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="120.0" minWidth="10.0" prefWidth="120.0" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="480.0" minWidth="10.0" prefWidth="370.0" />
            <ColumnConstraints hgrow="SOMETIMES" maxWidth="5.0" minWidth="0.0" prefWidth="0.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints maxHeight="310.0" minHeight="10.0" prefHeight="220.0" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="176.0" minHeight="10.0" prefHeight="63.0" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="143.0" minHeight="0.0" prefHeight="69.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <TableView fx:id="tableProducto" prefHeight="300.0" prefWidth="480.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
              <columns>
                <TableColumn fx:id="tableColumnIdProducto" prefWidth="80.0" text="ID" />
                <TableColumn fx:id="tableColumnNombreProducto" prefWidth="130.0" text="Nombre" />
                <TableColumn fx:id="tableColumnStock" prefWidth="83.0" text="Stock" />
                <TableColumn fx:id="tableColumnPrecio" prefWidth="76.0" text="Precio" />
              </columns>
            </TableView>

            <Button mnemonicParsing="false" onAction="#handleAgregarProducto" prefHeight="29.0" prefWidth="150.0" text="Añadir Producto" GridPane.columnIndex="1" GridPane.halignment="LEFT" GridPane.rowIndex="1" />
            <Button mnemonicParsing="false" onAction="#handleEliminarProducto" prefHeight="29.0" prefWidth="150.0" text="Eliminar Producto" GridPane.columnIndex="1" GridPane.halignment="RIGHT" GridPane.rowIndex="1" />
         </children>
      </GridPane>
   </children>
</AnchorPane>
